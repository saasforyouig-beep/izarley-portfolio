# Copie para server/.env e preencha
OPENAI_API_KEY=sk-...
# Origem permitida em produção (CORS). Em dev pode deixar *
ALLOWED_ORIGIN=http://localhost:5173,https://izarley.com.br
# Porta do servidor (opcional)
PORT=8787
# Modelo (opcional)
CHAT_MODEL=gpt-4o-mini
# Teto diário global de chamadas à OpenAI (proteção de gastos)
DAILY_MAX_CALLS=300

# Banco de dados (leads, mensagens, rastreio)
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Painel admin (/admin) — gere com: openssl rand -hex 24
ADMIN_TOKEN=

# Webhook para receber resumo+numero dos leads (ex.: fluxo N8N)
NOTIFY_WEBHOOK=
